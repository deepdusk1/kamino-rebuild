# Copy this file to `.env` and fill it in.
# Address of your Kamino server (the web app in the ../web folder). Must be reachable from the phone.
#   - Testing with Expo Go on your own Wi-Fi: leave this EMPTY, the app finds your computer itself.
#   - A real build for other people: use your public https address.
EXPO_PUBLIC_API_URL=
# Shown in Settings → Contact support. Use an address you actually read.
EXPO_PUBLIC_SUPPORT_EMAIL=
