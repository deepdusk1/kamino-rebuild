# For a shared production deployment, provision PostgreSQL and set these on the host.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-kamino-domain.example
VITE_AUTH_ENABLED=true
VITE_OAUTH_ENABLED=false
# Real sign-in integrations (buttons appear only when the provider credentials are present).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Production requires email confirmation by default. Set a verified sender.
# RESEND_API_KEY=
# MAIL_FROM=Kamino <hello@your-domain.example>
# KAMINO_REQUIRE_EMAIL_VERIFICATION=true
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Protect the scheduler with a long random secret; npm start launches its worker.
# KAMINO_JOB_SECRET=
# Enable only after native APNs/FCM credentials and registered tokens are verified.
KAMINO_PUSH_ENABLED=false
# Optional token when enhanced Expo push security is enabled in the project.
# EXPO_ACCESS_TOKEN=
# Payments default to off. See BILLING.md for the test-only checkout/webhook setup.
# Live keys are rejected; native app-store purchases and creator payouts are not yet supported.
# KAMINO_PAYMENTS_ENABLED=false
# KAMINO_BILLING_ORIGIN=https://your-domain.example
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# npm run dev generates a local secret and stores data in .local-data automatically.
# Optional: override the local data directory via KAMINO_DATA_DIR.
# Start with an empty site (no built-in sample communities, members or posts). Recommended for a real public server.
# KAMINO_SAMPLE_CONTENT=off
# NITRO_PRESET=node-server by default; vercel is also supported.

# Voice, video and screen sharing behind strict networks (optional). Free public STUN servers are always used;
# add a TURN relay so calls also connect through office or mobile networks. Either a coturn server with a shared secret:
# KAMINO_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# KAMINO_TURN_SECRET=
# or one fixed login from a TURN service (Twilio, Metered, and similar):
# KAMINO_TURN_USERNAME=
# KAMINO_TURN_CREDENTIAL=
# Abuse limits (posting, commenting, messaging...) are on by default. Set to off only for load tests.
# KAMINO_RATE_LIMIT=off

# Files (photos, videos, voice notes, covers, quiz pictures) can live in an S3-compatible bucket instead of the database
# (Amazon S3, Cloudflare R2, Backblaze B2, MinIO...). Leave these empty to keep everything in the database.
# The bucket must be PRIVATE: Kamino checks who may see a file and hands it over itself.
# KAMINO_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# KAMINO_S3_BUCKET=
# KAMINO_S3_ACCESS_KEY_ID=
# KAMINO_S3_SECRET_ACCESS_KEY=
# KAMINO_S3_REGION=auto
# Set to true only for a server that needs bucket-in-the-path addresses (MinIO and some others).
# KAMINO_S3_PATH_STYLE=false

# ── Configured AI (optional) ───────────────────────────────────────────────────
# Kamino always runs built-in safety rules. Add these for more:
# 1) Optional provider safety checks of text and pictures. Check current provider terms and limits.
#    Create a key at https://platform.openai.com/api-keys
# KAMINO_MODERATION_API_KEY=
# 2) Role-play and discovery/writing helpers: an OpenAI-compatible chat service.
#    Configure your provider account and supported model IDs. Provider quotas, costs and availability vary.
#    A comma-separated model list supports fallback. A local compatible service can also be configured;
#    its own resource limits still apply. The app does not return invented AI answers when unconfigured.
# KAMINO_AI_API_KEY=
# KAMINO_AI_BASE_URL=https://api.groq.com/openai/v1
# KAMINO_AI_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
# App-level daily reply cap for the whole server; this is not a provider quota or a pricing guarantee.
# KAMINO_AI_DAILY_LIMIT=300
# Semantic search, optional personalized feed ranking and duplicate detection.
# Requires an explicitly chosen embedding model supported by your provider. Disabled by default.
# KAMINO_SEMANTIC_SEARCH=on
# KAMINO_EMBEDDING_API_KEY=
# KAMINO_EMBEDDING_BASE_URL=https://api.openai.com/v1
# KAMINO_EMBEDDING_MODEL=
# KAMINO_EMBEDDING_DIMENSIONS=1536
# KAMINO_EMBEDDING_DAILY_CALLS=250
# KAMINO_EMBEDDING_DAILY_BYTES=2000000
# Indexing sends readable source content to that provider. Public content only by default.
# KAMINO_SEMANTIC_PRIVATE_CONTENT=off
# Site owners (comma-separated sign-in emails). They see serious safety cases from every community, direct
# messages and profile walls at /admin/safety, and are the only ones who can restore items linked to minors.
# KAMINO_ADMIN_EMAILS=you@example.com
